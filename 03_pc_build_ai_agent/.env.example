# LLM planner is optional; empty = deterministic rule-based planner
LLM_MODEL_PLANNER=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=12
AGENT_TOTAL_TIMEOUT=25
TOOL_TIMEOUT=5
# Empty URL = built-in mock. Fixed URLs only; the agent never builds URLs from user/tool text.
PRICE_SERVICE_URL=
STOCK_SERVICE_URL=
BENCHMARK_SERVICE_URL=
RAG_SERVICE_URL=
ALTERNATIVES_SERVICE_URL=
PROMPT_VERSION=p1
POLICY_VERSION=policy-2026-09
INTERNAL_TOKEN=dev-internal
MOCK_FAIL=
